From 53ed0637631e10a83e6a290050208956051f51fe Mon Sep 17 00:00:00 2001
From: xjosemi <xjosemi@localhost>
Date: Wed, 4 Nov 2026 06:48:28 +0000
Subject: [PATCH 1/2] gts4lv_defconfig: HZ 300, zram lz4 y quitar DEBUG_INFO

- CONFIG_HZ 100 -> 300: menos latencia de scheduling, UI mas reactiva
- zram con lz4/lz4hc: compresion mas rapida que lzo/lzorle
- sin CONFIG_DEBUG_INFO: imagen mas pequena y build mas rapido
- CC_OPTIMIZE_FOR_PERFORMANCE explicito

Change-Id: I64f541fa91a4b4713a32e46323f5d645fb57aa70
---
 arch/arm64/configs/gts4lv_defconfig | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/configs/gts4lv_defconfig b/arch/arm64/configs/gts4lv_defconfig
index a8d01acd0..89fa7b577 100644
--- a/arch/arm64/configs/gts4lv_defconfig
+++ b/arch/arm64/configs/gts4lv_defconfig
@@ -61,7 +61,7 @@ CONFIG_PCI_MSM=y
 CONFIG_SCHED_MC=y
 CONFIG_NR_CPUS=8
 CONFIG_PREEMPT=y
-CONFIG_HZ_100=y
+# CONFIG_HZ_100 is not set
 CONFIG_CLEANCACHE=y
 CONFIG_CMA=y
 CONFIG_ZSMALLOC=y
@@ -253,6 +253,15 @@ CONFIG_IPC_ROUTER_SECURITY=y
 CONFIG_FW_LOADER_USER_HELPER_FALLBACK=y
 CONFIG_DMA_CMA=y
 CONFIG_ZRAM=y
+CONFIG_HZ=300
+# CONFIG_HZ_250 is not set
+CONFIG_HZ_300=y
+CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
+CONFIG_CRYPTO_LZ4=y
+CONFIG_CRYPTO_LZ4HC=y
+CONFIG_ZRAM_DEF_COMP_LZ4=y
+# CONFIG_ZRAM_DEF_COMP_LZO is not set
+# CONFIG_ZRAM_DEF_COMP_LZORLE is not set
 CONFIG_BLK_DEV_LOOP=y
 CONFIG_BLK_DEV_LOOP_MIN_COUNT=16
 CONFIG_BLK_DEV_RAM=y
@@ -768,7 +777,7 @@ CONFIG_PSTORE_PMSG=y
 CONFIG_PSTORE_RAM=y
 # CONFIG_NETWORK_FILESYSTEMS is not set
 CONFIG_PRINTK_TIME=y
-CONFIG_DEBUG_INFO=y
+# CONFIG_DEBUG_INFO is not set
 CONFIG_MAGIC_SYSRQ=y
 CONFIG_PANIC_TIMEOUT=5
 CONFIG_SCHEDSTATS=y
-- 
2.43.0

