+
+package org.lineageos.dap
+
+import android.content.Context
+import android.content.SharedPreferences
+
+import androidx.preference.PreferenceManager
+
+/**
+ * Preferencias por dispositivo de salida.
+ *
+ * Cada salida (altavoz, cable, cada auricular Bluetooth por su MAC, USB...) tiene
+ * su propio fichero de preferencias. Asi el ajuste del altavoz no se pierde al
+ * conectar cascos y cada dispositivo recuerda lo que se le puso.
+ *
+ * Valores por defecto: en el altavoz SoundAlive va encendido (alli la curva stock
+ * se aplica siempre, con el interruptor encendido o apagado); en cualquier otra
+ * salida SoundAlive y Dolby van apagados.
+ */
+object DeviceState {
+    const val FILE_PREFIX = "dap_dev_"
+
+    private const val LEGACY_MIGRATED = "device_state_migrated"
+
+    /**
+     * Todo va en almacenamiento device-protected. El receptor de arranque aplica el
+     * estado antes de desbloquear (su contexto es device-protected) y el panel tiene
+     * que leer y escribir exactamente el mismo fichero; si no, cada uno usa uno.
+     */
+    private fun deviceContext(context: Context): Context =
+            context.createDeviceProtectedStorageContext()
+
+    fun prefs(context: Context): SharedPreferences =
+            prefs(context, AudioRoute.currentKey())
+
+    private fun prefs(context: Context, key: String): SharedPreferences =
+            deviceContext(context).getSharedPreferences(
+                    FILE_PREFIX + sanitize(key), Context.MODE_PRIVATE)
+
+    /** Default de SoundAlive: encendido solo en el altavoz. */
+    fun soundAliveDefault(): Boolean = AudioRoute.isSpeaker()
+
+    /**
+     * Las preferencias globales de antes (una sola configuracion para todo) pasan
+     * a ser las del altavoz. Solo se hace una vez y sin pisar nada ya guardado.
+     *
+     * Se miran las dos ubicaciones porque versiones anteriores escribian desde el
+     * arranque (device-protected) y desde el panel (credential-encrypted): lo que
+     * hubiera en cada una se copia, y lo de credential-encrypted manda si hay algo.
+     */
+    fun migrateLegacy(context: Context) {
+        val legacyDe = PreferenceManager.getDefaultSharedPreferences(deviceContext(context))
+        val legacyCe = PreferenceManager.getDefaultSharedPreferences(context)
+        if (legacyDe.getBoolean(LEGACY_MIGRATED, false)) return
+        val speaker = prefs(context, AudioRoute.KEY_SPEAKER)
+        if (speaker.all.isEmpty()) {
+            val editor = speaker.edit()
+            copyInto(editor, legacyDe)
+            copyInto(editor, legacyCe)
+            editor.apply()
+        }
+        legacyDe.edit().putBoolean(LEGACY_MIGRATED, true).apply()
+        legacyCe.edit().putBoolean(LEGACY_MIGRATED, true).apply()
+    }
+
+    private fun copyInto(editor: SharedPreferences.Editor, from: SharedPreferences) {
+        from.all.forEach { (name, value) ->
+            when (value) {
+                is Boolean -> editor.putBoolean(name, value)
+                is Int -> editor.putInt(name, value)
+                is Long -> editor.putLong(name, value)
+                is Float -> editor.putFloat(name, value)
+                is String -> editor.putString(name, value)
+            }
+        }
+    }
+
+    /** El nombre del fichero no admite ':' ni espacios (MAC, nombre de USB). */
+    private fun sanitize(key: String): String =
+            key.replace(Regex("[^A-Za-z0-9._-]"), "_")
+}
