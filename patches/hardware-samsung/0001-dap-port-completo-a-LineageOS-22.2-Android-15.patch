+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package org.lineageos.dap
+
+import android.content.Context
+import android.media.AudioAttributes
+import android.media.AudioDeviceCallback
+import android.media.AudioDeviceInfo
+import android.media.AudioManager
+import android.os.Handler
+import android.os.Looper
+import android.util.Log
+
+/**
+ * Vigila por donde esta saliendo el audio y mantiene el estado del dispositivo
+ * activo.
+ *
+ * La curva del DSP del altavoz ([SoundAliveCore.BASE]) es la correccion acustica
+ * del altavoz de la tablet: con auriculares, USB o Bluetooth no tiene sentido y
+ * ademas suena mal (los cascos ya vienen compensados). La stock hace lo mismo:
+ * consulta el tipo de dispositivo actual y solo aplica el refuerzo en el altavoz.
+ *
+ * Cada salida tiene su propia configuracion ([DeviceState]): al cambiar de
+ * dispositivo se aplica la suya, no la del anterior.
+ *
+ * El proceso de la app es persistente y de uid system, asi que basta con registrar
+ * el callback una vez: cuando se enchufan o se quitan cascos se reenvia el estado
+ * a los efectos que ya estan vivos.
+ */
+object AudioRoute {
+    const val KEY_SPEAKER = "speaker"
+
+    private const val TAG = "SamsungDAP"
+
+    fun interface Listener {
+        fun onRouteChanged(key: String, speaker: Boolean)
+    }
+
+    private val externalTypes = intArrayOf(
+            AudioDeviceInfo.TYPE_BLUETOOTH_A2DP,
+            AudioDeviceInfo.TYPE_BLUETOOTH_SCO,
+            AudioDeviceInfo.TYPE_BLE_HEADSET,
+            AudioDeviceInfo.TYPE_BLE_SPEAKER,
+            AudioDeviceInfo.TYPE_BLE_BROADCAST,
+            AudioDeviceInfo.TYPE_USB_DEVICE,
+            AudioDeviceInfo.TYPE_USB_HEADSET,
+            AudioDeviceInfo.TYPE_USB_ACCESSORY,
+            AudioDeviceInfo.TYPE_WIRED_HEADSET,
+            AudioDeviceInfo.TYPE_WIRED_HEADPHONES,
+            AudioDeviceInfo.TYPE_HEARING_AID,
+            AudioDeviceInfo.TYPE_HDMI,
+            AudioDeviceInfo.TYPE_HDMI_ARC,
+            AudioDeviceInfo.TYPE_HDMI_EARC,
+            AudioDeviceInfo.TYPE_LINE_ANALOG,
+            AudioDeviceInfo.TYPE_LINE_DIGITAL,
+            AudioDeviceInfo.TYPE_AUX_LINE,
+            AudioDeviceInfo.TYPE_DOCK,
+    )
+
+    private var audioManager: AudioManager? = null
+    private var appContext: Context? = null
+    private var registered = false
+
+    @Volatile private var key = KEY_SPEAKER
+    @Volatile private var label = ""
+    @Volatile private var speaker = true
+
+    private var listener: Listener? = null
+
+    private val callback = object : AudioDeviceCallback() {
+        override fun onAudioDevicesAdded(addedDevices: Array<out AudioDeviceInfo>?) = refresh()
+
+        override fun onAudioDevicesRemoved(removedDevices: Array<out AudioDeviceInfo>?) = refresh()
+    }
+
+    fun setListener(value: Listener?) {
+        listener = value
+    }
+
+    @Synchronized
+    fun init(context: Context) {
+        val manager = context.applicationContext
+                ?.getSystemService(Context.AUDIO_SERVICE) as? AudioManager
+        if (manager == null) return
+        audioManager = manager
+        appContext = context.applicationContext
+        DeviceState.migrateLegacy(context)
+        if (!registered) {
+            // Solo se da por registrado si el callback se ha registrado de verdad.
+            registered = runCatching {
+                manager.registerAudioDeviceCallback(callback, Handler(Looper.getMainLooper()))
+            }.isSuccess
+        }
+        refresh()
+    }
+
+    @Synchronized
+    fun currentKey(): String = key
+
+    @Synchronized
+    fun currentLabel(): String = label
+
+    @Synchronized
+    fun isSpeaker(): Boolean = speaker
+
+    @Synchronized
+    private fun refresh() {
+        val manager = audioManager ?: return
+        val device = resolve(manager)
+        val nowSpeaker = device == null || !isExternal(device.type)
+        val nowKey = if (device == null) KEY_SPEAKER else keyOf(device)
+        val context = appContext
+        val nowLabel = if (device == null) {
+            context?.getString(R.string.route_speaker).orEmpty()
+        } else {
+            labelOf(context, device)
+        }
+        val changed = nowKey != key || nowSpeaker != speaker
+
+        key = nowKey
+        speaker = nowSpeaker
+        label = nowLabel
+
+        if (context != null) {
+            // La ruta va antes que el estado: al apagar SoundAlive fuera del
+            // altavoz hay que soltar el efecto, y eso depende de la ruta.
+            SoundAliveCore.setRoute(nowSpeaker, nowKey)
+            DolbyCore.setRoute(nowSpeaker)
+            DolbyFragment.applyDolby(context)
+            DolbyFragment.applySoundAlive(context)
+        }
+
+        if (changed) {
+            Log.i(TAG, "salida: $nowKey (altavoz=$nowSpeaker)")
+            listener?.onRouteChanged(nowKey, nowSpeaker)
+        }
+    }
+
+    /** Orden de preferencia cuando hay varias salidas externas conectadas. */
+    private val priority = intArrayOf(
+            AudioDeviceInfo.TYPE_USB_HEADSET,
+            AudioDeviceInfo.TYPE_USB_DEVICE,
+            AudioDeviceInfo.TYPE_USB_ACCESSORY,
+            AudioDeviceInfo.TYPE_BLUETOOTH_A2DP,
+            AudioDeviceInfo.TYPE_BLE_HEADSET,
+            AudioDeviceInfo.TYPE_BLE_SPEAKER,
+            AudioDeviceInfo.TYPE_BLE_BROADCAST,
+            AudioDeviceInfo.TYPE_BLUETOOTH_SCO,
+            AudioDeviceInfo.TYPE_WIRED_HEADSET,
+            AudioDeviceInfo.TYPE_WIRED_HEADPHONES,
+            AudioDeviceInfo.TYPE_HEARING_AID,
+            AudioDeviceInfo.TYPE_HDMI,
+            AudioDeviceInfo.TYPE_HDMI_ARC,
+            AudioDeviceInfo.TYPE_HDMI_EARC,
+            AudioDeviceInfo.TYPE_LINE_ANALOG,
+            AudioDeviceInfo.TYPE_LINE_DIGITAL,
+            AudioDeviceInfo.TYPE_AUX_LINE,
+            AudioDeviceInfo.TYPE_DOCK,
+    )
+
+    /** Salida activa para musica. */
+    private fun resolve(manager: AudioManager): AudioDeviceInfo? {
+        val attributes = AudioAttributes.Builder()
+                .setUsage(AudioAttributes.USAGE_MEDIA)
+                .setContentType(AudioAttributes.CONTENT_TYPE_MUSIC)
+                .build()
+        val outputs = runCatching {
+            manager.getDevices(AudioManager.GET_DEVICES_OUTPUTS)
+        }.getOrNull()?.toList().orEmpty()
+        if (outputs.isEmpty()) return null
+        // getDevicesForAttributes devuelve atributos, no AudioDeviceInfo: se busca
+        // el dispositivo real por tipo y direccion.
+        val routed = runCatching {
+            manager.getDevicesForAttributes(attributes)
+        }.getOrNull().orEmpty()
+        for (attribute in routed) {
+            if (!isExternal(attribute.type)) continue
+            val match = outputs.firstOrNull {
+                it.type == attribute.type && it.address == attribute.address
+            }
+            if (match != null) return match
+        }
+        // En reposo el AudioPolicy sigue contestando "altavoz" aunque haya unos
+        // cascos Bluetooth conectados (la ruta de musica solo cambia al empezar a
+        // reproducir). La stock mira el dispositivo conectado, asi que se prefiere
+        // la salida externa si existe: mejor no aplicar la curva del altavoz a unos
+        // cascos que al reves.
+        val connected = outputs
+                .filter { isExternal(it.type) }
+                .minByOrNull { priority.indexOf(it.type).let { i -> if (i < 0) Int.MAX_VALUE else i } }
+        if (connected != null) return connected
+        return outputs.firstOrNull { it.type == AudioDeviceInfo.TYPE_BUILTIN_SPEAKER }
+                ?: outputs.first()
+    }
+
+    private fun isExternal(type: Int): Boolean = externalTypes.contains(type)
+
+    /**
+     * Clave estable por dispositivo fisico: Bluetooth por MAC, USB por nombre o
+     * direccion, el cable por tipo (no hay forma de distinguir dos cables).
+     */
+    private fun keyOf(device: AudioDeviceInfo): String = when (device.type) {
+        AudioDeviceInfo.TYPE_BUILTIN_SPEAKER -> KEY_SPEAKER
+        AudioDeviceInfo.TYPE_WIRED_HEADSET,
+        AudioDeviceInfo.TYPE_WIRED_HEADPHONES -> "wired"
+        AudioDeviceInfo.TYPE_BLUETOOTH_A2DP,
+        AudioDeviceInfo.TYPE_BLUETOOTH_SCO,
+        AudioDeviceInfo.TYPE_BLE_HEADSET,
+        AudioDeviceInfo.TYPE_BLE_SPEAKER,
+        AudioDeviceInfo.TYPE_BLE_BROADCAST -> "bt:" + stableId(device, "bt")
+        AudioDeviceInfo.TYPE_USB_DEVICE,
+        AudioDeviceInfo.TYPE_USB_HEADSET,
+        AudioDeviceInfo.TYPE_USB_ACCESSORY -> "usb:" + stableId(device, "usb")
+        AudioDeviceInfo.TYPE_HDMI,
+        AudioDeviceInfo.TYPE_HDMI_ARC,
+        AudioDeviceInfo.TYPE_HDMI_EARC -> "hdmi"
+        AudioDeviceInfo.TYPE_LINE_ANALOG,
+        AudioDeviceInfo.TYPE_LINE_DIGITAL,
+        AudioDeviceInfo.TYPE_AUX_LINE -> "line"
+        AudioDeviceInfo.TYPE_DOCK -> "dock"
+        AudioDeviceInfo.TYPE_HEARING_AID -> "hearing_aid"
+        else -> "type:" + device.type
+    }
+
+    private fun stableId(device: AudioDeviceInfo, fallback: String): String {
+        val address = device.address
+        if (!address.isNullOrBlank() && address != "00:00:00:00:00:00") return address
+        val name = device.productName?.toString()
+        if (!name.isNullOrBlank()) return name
+        return "$fallback-${device.type}"
+    }
+
+    private fun labelOf(context: Context?, device: AudioDeviceInfo): String {
+        val id = device.address?.takeIf {
+            !it.isNullOrBlank() && it != "00:00:00:00:00:00"
+        } ?: device.productName?.toString()?.takeIf { it.isNotBlank() }
+        return when (device.type) {
+            AudioDeviceInfo.TYPE_BUILTIN_SPEAKER ->
+                context?.getString(R.string.route_speaker).orEmpty()
+            AudioDeviceInfo.TYPE_WIRED_HEADSET,
+            AudioDeviceInfo.TYPE_WIRED_HEADPHONES ->
+                context?.getString(R.string.route_wired).orEmpty()
+            AudioDeviceInfo.TYPE_BLUETOOTH_A2DP,
+            AudioDeviceInfo.TYPE_BLUETOOTH_SCO,
+            AudioDeviceInfo.TYPE_BLE_HEADSET,
+            AudioDeviceInfo.TYPE_BLE_SPEAKER,
+            AudioDeviceInfo.TYPE_BLE_BROADCAST ->
+                if (id == null) {
+                    context?.getString(R.string.route_bluetooth).orEmpty()
+                } else {
+                    context?.getString(R.string.route_bluetooth_named, id).orEmpty()
+                }
+            AudioDeviceInfo.TYPE_USB_DEVICE,
+            AudioDeviceInfo.TYPE_USB_HEADSET,
+            AudioDeviceInfo.TYPE_USB_ACCESSORY ->
+                if (id == null) {
+                    context?.getString(R.string.route_usb).orEmpty()
+                } else {
+                    context?.getString(R.string.route_usb_named, id).orEmpty()
+                }
+            AudioDeviceInfo.TYPE_HDMI,
+            AudioDeviceInfo.TYPE_HDMI_ARC,
+            AudioDeviceInfo.TYPE_HDMI_EARC ->
+                context?.getString(R.string.route_hdmi).orEmpty()
+            AudioDeviceInfo.TYPE_LINE_ANALOG,
+            AudioDeviceInfo.TYPE_LINE_DIGITAL,
+            AudioDeviceInfo.TYPE_AUX_LINE ->
+                context?.getString(R.string.route_line).orEmpty()
+            else -> device.productName?.toString()?.takeIf { it.isNotBlank() }
+                    ?: context?.getString(R.string.route_other, device.type).orEmpty()
+        }
+    }
+}
