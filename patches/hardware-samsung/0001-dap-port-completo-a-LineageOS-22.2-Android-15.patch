+package org.lineageos.dap
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.RectF
+import android.util.AttributeSet
+import android.view.MotionEvent
+import android.view.View
+
+/**
+ * Ecualizador grafico de 9 bandas dibujado a mano: barras verticales con la linea
+ * de 0 dB en el centro, valor en dB encima y frecuencia debajo.
+ *
+ * No se usan SeekBar rotados porque la rotacion no cambia los limites de layout y
+ * quedaban recortados.
+ */
+class EqualizerView(context: Context, attrs: AttributeSet?) : View(context, attrs) {
+
+    var onLevelsChanged: ((IntArray) -> Unit)? = null
+
+    private val frequencies = intArrayOf(63, 125, 250, 500, 1000, 2000, 4000, 8000, 16000)
+    private val levels = IntArray(SoundAliveCore.BANDS)
+
+    private val trackPaint = Paint().apply {
+        color = Color.parseColor("#33FFFFFF")
+        style = Paint.Style.FILL
+    }
+    private val filledPaint = Paint().apply {
+        color = Color.parseColor("#4DD0E1")
+        style = Paint.Style.FILL
+    }
+    private val zeroPaint = Paint().apply {
+        color = Color.parseColor("#66FFFFFF")
+        strokeWidth = 2f
+    }
+    private val thumbPaint = Paint().apply {
+        color = Color.parseColor("#4DD0E1")
+        style = Paint.Style.FILL
+    }
+    private val valuePaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        color = Color.WHITE
+        textAlign = Paint.Align.CENTER
+    }
+    private val freqPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        color = Color.parseColor("#99FFFFFF")
+        textAlign = Paint.Align.CENTER
+    }
+
+    private var activeBand = -1
+    private var editable = true
+
+    /** Con un preset fijo las barras se muestran pero no se pueden tocar. */
+    fun setEditable(value: Boolean) {
+        editable = value
+        alpha = if (value) 1f else 0.55f
+        invalidate()
+    }
+
+    fun setLevels(values: IntArray) {
+        for (band in 0 until SoundAliveCore.BANDS) {
+            levels[band] = values.getOrElse(band) { 0 }
+                    .coerceIn(SoundAliveCore.MIN_LEVEL, SoundAliveCore.MAX_LEVEL)
+        }
+        invalidate()
+    }
+
+    fun getLevels(): IntArray = levels.copyOf()
+
+    override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
+        val width = MeasureSpec.getSize(widthMeasureSpec)
+        val height = (resources.displayMetrics.density * 260).toInt()
+        setMeasuredDimension(width, height)
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        super.onDraw(canvas)
+
+        val valueSize = resources.displayMetrics.scaledDensity * 11f
+        val freqSize = resources.displayMetrics.scaledDensity * 10f
+        valuePaint.textSize = valueSize
+        freqPaint.textSize = freqSize
+
+        val paddingTop = valueSize * 1.6f
+        val paddingBottom = freqSize * 2.0f
+        val trackTop = paddingTop
+        val trackBottom = height - paddingBottom
+        val trackHeight = trackBottom - trackTop
+        if (trackHeight <= 0) return
+
+        val slot = width.toFloat() / SoundAliveCore.BANDS
+        val barWidth = slot * 0.42f
+        val radius = barWidth / 2f
+
+        val zeroY = trackTop + trackHeight / 2f
+        canvas.drawLine(0f, zeroY, width.toFloat(), zeroY, zeroPaint)
+
+        val range = SoundAliveCore.MAX_LEVEL - SoundAliveCore.MIN_LEVEL
+        for (band in 0 until SoundAliveCore.BANDS) {
+            val centerX = slot * band + slot / 2f
+            val left = centerX - barWidth / 2f
+
+            canvas.drawRoundRect(RectF(left, trackTop, left + barWidth, trackBottom),
+                    radius, radius, trackPaint)
+
+            val level = levels[band]
+            val fraction = (level - SoundAliveCore.MIN_LEVEL).toFloat() / range
+            val barTop = trackBottom - trackHeight * fraction
+            val from = minOf(barTop, zeroY)
+            val to = maxOf(barTop, zeroY)
+            if (to - from > 1f) {
+                canvas.drawRoundRect(RectF(left, from, left + barWidth, to), radius, radius,
+                        filledPaint)
+            }
+            canvas.drawCircle(centerX, barTop, barWidth * 0.62f, thumbPaint)
+
+            val text = if (level > 0) "+$level" else level.toString()
+            canvas.drawText(text, centerX, paddingTop - valueSize * 0.35f, valuePaint)
+            canvas.drawText(label(frequencies[band]), centerX, height - freqSize * 0.6f, freqPaint)
+        }
+    }
+
+    private fun label(hz: Int) = if (hz >= 1000) "${hz / 1000}k" else hz.toString()
+
+    override fun onTouchEvent(event: MotionEvent): Boolean {
+        if (!editable) return false
+        when (event.actionMasked) {
+            MotionEvent.ACTION_DOWN -> parent?.requestDisallowInterceptTouchEvent(true)
+            MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL ->
+                parent?.requestDisallowInterceptTouchEvent(false)
+        }
+        when (event.actionMasked) {
+            MotionEvent.ACTION_DOWN, MotionEvent.ACTION_MOVE -> {
+                val slot = width.toFloat() / SoundAliveCore.BANDS
+                val band = (event.x / slot).toInt()
+                        .coerceIn(0, SoundAliveCore.BANDS - 1)
+                activeBand = band
+                updateBandFromY(band, event.y)
+                return true
+            }
+            MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> {
+                activeBand = -1
+                return true
+            }
+        }
+        return super.onTouchEvent(event)
+    }
+
+    private fun updateBandFromY(band: Int, y: Float) {
+        val valueSize = resources.displayMetrics.scaledDensity * 11f
+        val freqSize = resources.displayMetrics.scaledDensity * 10f
+        val trackTop = valueSize * 1.6f
+        val trackBottom = height - freqSize * 2.0f
+        val trackHeight = trackBottom - trackTop
+        if (trackHeight <= 0) return
+
+        val fraction = ((trackBottom - y) / trackHeight).coerceIn(0f, 1f)
+        val range = SoundAliveCore.MAX_LEVEL - SoundAliveCore.MIN_LEVEL
+        val level = SoundAliveCore.MIN_LEVEL + Math.round(fraction * range)
+        if (level == levels[band]) return
+
+        levels[band] = level
+        invalidate()
+        onLevelsChanged?.invoke(levels.copyOf())
+    }
+}
