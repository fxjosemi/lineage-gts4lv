+
+package org.lineageos.dap
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.media.audiofx.AudioEffect
+import android.util.Log
+
+/**
+ * Recibe la sesion de audio que abre cada reproductor (Spotify, YouTube, ...) y
+ * aplica la ecualizacion a esa sesion concreta. Es el mismo mecanismo que usa
+ * MusicFX: el reproductor emite OPEN_AUDIO_EFFECT_CONTROL_SESSION con
+ * EXTRA_AUDIO_SESSION y el sistema reenvia el intent al primer receptor que
+ * declare la accion (AudioService#handleAudioEffectBroadcast).
+ */
+class EffectSessionReceiver : BroadcastReceiver() {
+
+    override fun onReceive(context: Context, intent: Intent) {
+        if (intent.action == ACTION_PROBE) {
+            probe(intent.getIntExtra(AudioEffect.EXTRA_AUDIO_SESSION, 0))
+            return
+        }
+        if (intent.action == ACTION_TESTPLAY) {
+            testPlay(context)
+            return
+        }
+        val session = intent.getIntExtra(AudioEffect.EXTRA_AUDIO_SESSION, 0)
+        Log.i(TAG, "${intent.action} session=$session")
+
+        when (intent.action) {
+            AudioEffect.ACTION_OPEN_AUDIO_EFFECT_CONTROL_SESSION -> {
+                if (session <= 0) return
+                AudioRoute.init(context)
+                // El estado se carga ANTES de crear el efecto: si no, el motor
+                // arranca con los valores por defecto y se oye un salto (la curva
+                // del perfil anterior o la base sin el ecualizador).
+                // No se crea una instancia por sesion: la curva vive en la sesion
+                // global (0). Si se creara en las dos, el audio del reproductor
+                // pasaria por el efecto dos veces (sonaba distinto segun la app).
+                DolbyFragment.applySoundAlive(context)
+            }
+            AudioEffect.ACTION_CLOSE_AUDIO_EFFECT_CONTROL_SESSION -> {
+                // Nada que soltar: no hay instancia por sesion.
+            }
+        }
+    }
+
+    /** Sonda de diagnostico: prueba que tipos de efecto existen de verdad. */
+    private fun probe(session: Int) {
+        val types = linkedMapOf(
+                "equalizer" to "c8e70ecd-48ca-456e-8a4f-0002a5d5c51b",
+                "bassboost" to "14804144-a5ee-4d24-aa88-0002a5d5c51b",
+                "dap" to "6ab06da4-c516-4611-8166-452799218539",
+                "dap_proxy" to "9d4921da-8225-4f29-aefa-39537a04bcaa",
+                "sa3d_proxy" to "1c91fca0-664a-11e4-b8c2-0002a5d5c51b",
+                "sa3d_sw" to "3462a6e0-655a-11e4-8b67-0002a5d5c51b",
+                "soundalive_proxy" to "05227ea0-50bb-11e3-ac69-0002a5d5c51b",
+                "soundalive_sw" to "cf65eb39-ce2f-48a8-a903-ceb818c06745",
+                "dha_proxy" to "37155c20-50bb-11e3-9fac-0002a5d5c51b",
+                "mysound_sw" to "263a88e0-50b1-11e2-bcfd-0800200c9a66",
+                "soundbooster" to "50de45f0-5d4c-11e5-a837-0800200c9a66",
+                "legacy_sa" to "c4da1d1f-7cdf-42e2-ba60-efc7eb3508a3",
+                "legacy_dap" to "46d279d9-9be7-453d-9d7c-ef937f675587",
+                "aosp_downmix" to "93f04452-e4fe-41cc-91f9-e475b6d1d69f",
+                "aosp_loudness" to "fa415329-2034-4bea-b5dc-5b381c8d1e2c",
+                "aosp_audiosphere" to "184e62ab-2d19-4364-9d1b-c0a40733866c",
+                "aosp_shoebox" to "1eab784c-1a36-4b2a-b7fc-e34c44cab89e",
+                "aosp_dynproc" to "e0e6539b-1781-7261-676f-6d7573696340",
+                "aosp_hw_acc" to "7d1580bd-297f-4683-9239-e475b6d1d69f",
+                "vr3d" to "e6388202-e7a4-4c72-b68a-332eeeba269b",
+                "music_helper" to "08b8b058-0590-11e5-ac71-0025b32654a0",
+                "ring_helper" to "0956df94-0590-11e5-bdbe-0025b32654a0",
+                "aec" to "0f8d0d2a-59e5-45fe-b6e4-248c8a799109",
+                "volume" to "119341a0-8469-11df-81f9-0002a5d5c51b")
+        for ((name, uuid) in types) {
+            run {
+                val effect = runCatching {
+                    AudioEffect(java.util.UUID.fromString(uuid), AudioEffect.EFFECT_TYPE_NULL,
+                            0, session)
+                }.getOrNull()
+                if (effect != null) {
+                    Log.i(TAG, "PROBE $name session=$session OK uuid=$uuid id=${effect.id}")
+                    runCatching { effect.enabled = true }
+                    runCatching { effect.release() }
+                } else {
+                    Log.i(TAG, "PROBE $name session=$session FALLO uuid=$uuid")
+                }
+            }
+        }
+    }
+
+    /** Tono de prueba: crea una sesion de audio real con MediaPlayer. */
+    private fun testPlay(context: Context) {
+        val dir = java.io.File("/product/media/audio/alarms")
+        val file = dir.listFiles()?.firstOrNull() ?: run {
+            Log.i(TAG, "TESTPLAY sin ficheros en $dir")
+            return
+        }
+        val player = android.media.MediaPlayer()
+        runCatching {
+            player.setDataSource(file.absolutePath)
+            player.isLooping = true
+            player.setVolume(0.4f, 0.4f)
+            player.prepare()
+            player.start()
+        }.onFailure { Log.i(TAG, "TESTPLAY fallo ${it.message}") }
+        Log.i(TAG, "TESTPLAY ${file.name} session=${player.audioSessionId}")
+    }
+
+    companion object {
+        private const val TAG = "SamsungDAP"
+        private const val ACTION_PROBE = "org.lineageos.dap.PROBE"
+        private const val ACTION_TESTPLAY = "org.lineageos.dap.TESTPLAY"
+    }
+}
