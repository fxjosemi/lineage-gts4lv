+package org.lineageos.dap
+
+import android.app.Application
+
+/**
+ * El proceso es persistente, pero si el sistema lo reinicia no pasa por ningun
+ * receiver ni por la actividad: sin inicializar aqui, el callback de dispositivos
+ * de audio no se registra hasta que se abre una sesion de reproduccion, y mientras
+ * tanto un cambio a Bluetooth o cascos no se detecta.
+ */
+class DapApplication : Application() {
+
+    override fun onCreate() {
+        super.onCreate()
+        AudioRoute.init(this)
+    }
+}
