+
+package org.lineageos.dap
+
+import android.media.audiofx.AudioEffect
+import android.util.Log
+
+import java.util.UUID
+
+/**
+ * Ecualizador de Samsung (libaudiosaplus_sec.so) sobre la sesion de audio de cada
+ * reproductor.
+ *
+ * Por que por sesion: un efecto creado en la sesion 0 no llega a los reproductores
+ * que abren la suya (Spotify usa la suya), y quedaba habilitado sin procesar nada.
+ *
+ * Controles que funcionan, comprobados en la tablet:
+ *
+ *   - 9 bandas:  id 2  setLevel(banda, nivel), param=[2, banda], value=[nivel]
+ *                bandas 0..8, nivel -12..+12 dB.
+ *   - flags:     id 14 setGlobalEffectInfo -> value=[SAPlus, TubeAmp, contentType].
+ *                Confirmado en logcat:
+ *                  "setGlobalEffectInfo changed ... mGlobalSAPlus = 1,
+ *                   mGlobalTubeAmp = 0, mGlobalConcertHall = 0"
+ *                ConcertHall va forzado a 0 dentro de ese manejador (por eso el
+ *                reverb no se puede activar por aqui; era lo que metia el eco).
+ *   - 3D:        efecto aparte (MySpace, TYPE b6c0ace0...), se crea por sesion.
+ *
+ * NO funciona: id 9 (setPreset) no cambia el sonido en este equipo, e id 10/11/13
+ * tampoco hacen nada medible. Por eso los perfiles de Samsung se reproducen con
+ * las 9 bandas usando sus curvas medidas con el propio motor (relativas al perfil
+ * Normal), que es la unica via que si suena.
+ *
+ * IMPORTANTE: setGlobalEffectInfo actua sobre el motor GLOBAL del proceso de audio.
+ *
+ * La curva del DSP del altavoz ([BASE]) va SIEMPRE aplicada cuando la salida es el
+ * altavoz: el interruptor maestro solo mete o quita el ecualizador de usuario
+ * encima, de modo que al apagarlo el sonido queda como la stock (curva del altavoz
+ * y nada mas) y no plano. Con cascos, USB o Bluetooth la curva no se manda ([AudioRoute]).
+ * La stock tambien funciona asi: SoundBooster es una etapa fija antes de SoundAlive.
+ */
+object SoundAliveCore {
+    // Nuestro efecto (hardware/samsung/dap/eq): la curva del altavoz va dentro
+    // de la libreria, aqui solo se mandan los ajustes del usuario.
+    private val EFFECT_TYPES_SA = listOf(
+            UUID.fromString("d1e0a001-7c00-4b00-9f00-000000000001"))
+
+    private fun createEffect(types: List<UUID>, sessionId: Int): AudioEffect? {
+        for (uuid in types) {
+            val effect = runCatching {
+                AudioEffect(uuid, AudioEffect.EFFECT_TYPE_NULL, 0, sessionId)
+            }.onFailure {
+                Log.w("SamsungDAP", "SoundAlive: $uuid no disponible en la sesion $sessionId", it)
+            }.getOrNull()
+            if (effect != null) {
+                Log.i("SamsungDAP", "SoundAlive: efecto $uuid en la sesion $sessionId")
+                return effect
+            }
+        }
+        return null
+    }
+
+    // Protocolo de libdapeq: 1 = bypass, 2 = pre-ganancia, 10+n = banda n y
+    // 20 = curva entera. Todo en centesimas de dB.
+    private const val PARAM_BYPASS = 1
+    private const val PARAM_PREGAIN = 2
+    private const val PARAM_BAND_FIRST = 10
+    private const val PARAM_CURVE = 20
+
+    const val BANDS = 9
+    const val MIN_LEVEL = -12
+    const val MAX_LEVEL = 12
+    private const val MAX_SESSIONS = 8
+
+    const val PRESET_CUSTOM = "custom"
+    const val PRESET_DEFAULT = "neutral"
+
+    /** Curva fija del DSP del altavoz de Samsung, base de todos los perfiles. */
+    val BASE = intArrayOf(1, 4, 3, -6, 1, -3, -12, -2, 4)
+
+    /**
+     * Perfiles, como ajuste en dB sobre [BASE] (bandas 63/125/250/500/1k/2k/4k/8k/16k).
+     *
+     * Los tres primeros son propios. Los cinco de Samsung reproducen las curvas
+     * medidas con el propio motor (presets 0..4), relativas al perfil Normal:
+     *   Pop      +8,1 dB @100 Hz | +4,0 @200 | -1,9 @1k | -4,8 @6k
+     *   Clasica  +9,4 @100 | +5,1 @200 | -2,0 @1k | -5,1 @6k
+     *   Jazz     +7,7 @100 | +2,3 @200 | -1,9 @1k | -9,3 @6k
+     *   Rock     +7,7 @100 | +2,3 @200 | -1,8 @1k | -9,4 @6k
+     */
+    val PRESETS: Map<String, IntArray> = linkedMapOf(
+            "neutral" to intArrayOf(0, 0, 0, 0, 0, 0, 0, 0, 0),
+            "bass" to intArrayOf(3, 5, 3, 0, 0, 0, 0, 0, 0),
+            "bass_max" to intArrayOf(6, 8, 5, 1, 0, 0, 0, 0, 0),
+            // Pop y Clasica: medidos del motor (casi identicos entre si, 1,3 dB).
+            "sa_pop" to intArrayOf(9, 8, 5, 1, -2, -3, -4, -5, -5),
+            "sa_classic" to intArrayOf(10, 9, 6, 2, -2, -3, -4, -5, -5),
+            // Jazz: medido del motor (caida progresiva de agudos).
+            "sa_jazz" to intArrayOf(8, 7, 3, 1, -2, -5, -8, -9, -9),
+            // Rock: el motor lo da practicamente igual que Jazz (0,1 dB de
+            // diferencia), asi que se usa la curva en V clasica del rock para que
+            // los perfiles se distingan: graves y agudos arriba, medios atras.
+            "sa_rock" to intArrayOf(10, 7, 2, -1, -2, 0, 2, 3, 2),
+    )
+
+    val PRESET_NAMES: List<String> = PRESETS.keys.toList() + PRESET_CUSTOM
+
+    private const val GLOBAL_SESSION = 0
+
+    private val sessions = LinkedHashSet<Int>()
+    private val effects = LinkedHashMap<Int, AudioEffect>()
+    private val surroundEffects = LinkedHashMap<Int, AudioEffect>()
+
+    private var enabled = true
+    private var surround = false
+    private var tubeAmp = false
+    private var preset = PRESET_DEFAULT
+    private var offsets = IntArray(BANDS)
+    // La curva del altavoz solo se manda cuando la salida es el altavoz.
+    private var speakerRoute = true
+    // Dispositivo de salida activo: Bluetooth por MAC, USB por nombre, etc.
+    private var deviceKey = AudioRoute.KEY_SPEAKER
+
+    @Synchronized
+    fun addSession(sessionId: Int) {
+        if (sessionId <= 0) return
+        if (!sessions.contains(sessionId) && sessions.size >= MAX_SESSIONS) {
+            val oldest = sessions.first()
+            sessions.remove(oldest)
+            releaseSession(oldest)
+        }
+        sessions.add(sessionId)
+        // En el altavoz la curva de la stock va siempre, este encendido o apagado
+        // el interruptor. Fuera del altavoz solo se crea si el usuario ha puesto
+        // una curva que no sea neutra.
+        if (eqNeeded()) createFor(sessionId)
+        if (enabled && surround) createSurround(sessionId)
+    }
+
+    @Synchronized
+    fun removeSession(sessionId: Int) {
+        sessions.remove(sessionId)
+        releaseSession(sessionId)
+    }
+
+    /**
+     * El interruptor solo mete o quita el ecualizador del usuario (y el 3D). En el
+     * altavoz la curva de la stock sigue puesta siempre, sin tocarse; fuera del
+     * altavoz apagar el interruptor (o quedarse en Neutro) suelta el efecto.
+     */
+    @Synchronized
+    fun setEnabled(value: Boolean) {
+        enabled = value
+        // Se reaplica siempre, cambie o no el valor: el motor puede haber perdido
+        // el estado (patch recreado, cambio de ruta) y hay que dejarlo coherente.
+        refreshEffects()
+    }
+
+    @Synchronized
+    fun isEnabled() = enabled
+
+    @Synchronized
+    fun currentPreset() = preset
+
+    @Synchronized
+    fun isCustom() = preset == PRESET_CUSTOM
+
+    @Synchronized
+    fun getOffsets(): IntArray = offsets.copyOf()
+
+    @Synchronized
+    fun effectiveLevels(): IntArray = IntArray(BANDS) { band ->
+        // La curva del altavoz va siempre de base y los perfiles del usuario se
+        // suman encima. (Se intento mover la base a un device effect del XML, pero
+        // esta ROM no puede: el patch del altavoz al arrancar es HW y
+        // DeviceEffectProxy no puede enganchar efectos a un patch HW.)
+        val base = if (speakerRoute) BASE[band] else 0
+        (base + if (enabled) offsets[band] else 0).coerceIn(MIN_LEVEL, MAX_LEVEL)
+    }
+
+    /**
+     * Cambio de salida de audio.
+     *
+     * En el altavoz el efecto tiene que estar vivo siempre para que suene la curva
+     * de la stock, con el interruptor encendido o apagado. Fuera del altavoz, si el
+     * interruptor esta apagado o el perfil es Neutro no debe quedar ningun efecto
+     * (ni curva ni EQ); si hay una curva de usuario solo se manda esa (base = 0).
+     */
+    @Synchronized
+    fun setRoute(isSpeaker: Boolean, key: String) {
+        val routeChanged = speakerRoute != isSpeaker
+        val deviceChanged = deviceKey != key
+        speakerRoute = isSpeaker
+        deviceKey = key
+        if (!routeChanged && !deviceChanged) return
+        refreshEffects()
+    }
+
+    @Synchronized
+    fun isSpeakerRoute() = speakerRoute
+
+    @Synchronized
+    fun setPreset(name: String) {
+        if (!PRESET_NAMES.contains(name)) return
+        preset = name
+        PRESETS[name]?.let { offsets = it.copyOf() }
+        // Fuera del altavoz, Neutro no procesa nada: se suelta el efecto. Si ya
+        // existe, createFor sale antes y solo se reenvian las bandas.
+        ensureEq()
+        // Solo cambian las bandas: no hace falta reenviar los parametros globales
+        // (id 14 reconfigura el motor entero y metia un corte en cada cambio).
+        sendBands()
+    }
+
+    /** Cambia el nombre del perfil sin reaplicar nada (ecualizador manual). */
+    @Synchronized
+    fun setPresetName(name: String) {
+        if (PRESET_NAMES.contains(name)) preset = name
+    }
+
+    /**
+     * Rehace los efectos desde cero con el estado actual. Se usa al quitar Dolby:
+     * el DAP y SoundAlive comparten el proceso de audio, y recrear el efecto es la
+     * unica forma de garantizar que el motor no se queda con nada del estado
+     * anterior (equivale al "recrear el patch" de la stock).
+     */
+    @Synchronized
+    fun rebuild() {
+        effects.keys.toList().forEach { releaseEq(it) }
+        surroundEffects.keys.toList().forEach { releaseSurround(it) }
+        refreshEffects()
+    }
+
+    @Synchronized
+    fun setOffsets(values: IntArray) {
+        offsets = IntArray(BANDS) { band ->
+            values.getOrElse(band) { 0 }.coerceIn(MIN_LEVEL, MAX_LEVEL)
+        }
+        // Al mover una barra puede pasarse de Neutro a una curva (o al reves), y
+        // fuera del altavoz eso decide si el efecto tiene que existir.
+        ensureEq()
+        // Solo bandas: esto se llama en cada movimiento de una barra del ecualizador
+        // y reenviar los globales (id 14) reconfigura el motor y chasquea.
+        sendBands()
+    }
+
+    @Synchronized
+    fun setSurround(value: Boolean) {
+        if (surround == value) return
+        surround = value
+        if (value) {
+            if (!enabled) return
+            sessions.toList().forEach { createSurround(it) }
+        } else {
+            releaseSurroundAll()
+        }
+    }
+
+    @Synchronized
+    fun isSurround() = surround
+
+    @Synchronized
+    fun setTubeAmp(value: Boolean) {
+        if (tubeAmp == value) return
+        tubeAmp = value
+        applyAll()
+    }
+
+    @Synchronized
+    fun isTubeAmp() = tubeAmp
+
+    private fun applyAll() {
+        effects.values.forEach { apply(it) }
+    }
+
+    /**
+     * El efecto de SoundAlive solo existe en el altavoz: alli va siempre, para
+     * mandar la curva de la stock (con el interruptor encendido o apagado) y, si el
+     * usuario lo enciende, sumar su curva encima. Fuera del altavoz no se procesa
+     * nada: ni curva ni ecualizador (el DSP suena artificial en cascos).
+     */
+    // La curva base va SIEMPRE en el altavoz (con Dolby encendido o apagado); lo
+    // que manda el interruptor son los ajustes del usuario encima.
+    private fun eqNeeded(): Boolean = speakerRoute
+
+    /** Crea o suelta el efecto sin reaplicar parametros (cambio de perfil/bandas). */
+    private fun ensureEq() {
+        val needed = eqNeeded()
+        sessions.toList().forEach { if (needed) createFor(it) else releaseEq(it) }
+    }
+
+    /** Deja los efectos creados o sueltos segun la ruta y la curva, y aplica todo. */
+    private fun refreshEffects() {
+        // La sesion 0 es la salida global del dispositivo: se engancha siempre
+        // para que el motor se aplique aunque el reproductor no abra sesion
+        // (Spotify no manda OPEN_AUDIO_EFFECT_CONTROL_SESSION).
+        sessions.add(GLOBAL_SESSION)
+        val needed = eqNeeded()
+        sessions.toList().forEach { session ->
+            if (needed) createFor(session) else releaseEq(session)
+            if (enabled && surround) createSurround(session) else releaseSurround(session)
+        }
+        applyAll()
+    }
+
+    /**
+     * Suelta el 3D de todas las sesiones. MySpace es un motor global: si solo se
+     * hace release() sin desactivarlo antes, el motor sigue procesando y el 3D
+     * "no se quita" (seguia sonando aunque el interruptor estuviera apagado).
+     */
+    private fun releaseSurroundAll() {
+        surroundEffects.keys.toList().forEach { releaseSurround(it) }
+    }
+
+    private fun releaseSurround(sessionId: Int) {
+        surroundEffects.remove(sessionId)?.let { effect ->
+            runCatching { effect.enabled = false }
+            runCatching { effect.release() }
+        }
+    }
+
+    private fun sendBands() {
+        val levels = effectiveLevels()
+        effects.values.forEach { effect ->
+            runCatching {
+                for (band in 0 until BANDS) {
+                    effect.setParameter(ints(PARAM_BAND_FIRST + band), ints(levels[band] * 100))
+                }
+            }
+        }
+    }
+
+    private fun createFor(sessionId: Int) {
+        if (effects.containsKey(sessionId)) return
+        val effect = createEffect(EFFECT_TYPES_SA, sessionId) ?: return
+        effects[sessionId] = effect
+        apply(effect)
+    }
+
+    private fun createSurround(sessionId: Int) {
+        // libdapeq no hace 3D todavia: el surround se queda fuera.
+    }
+
+    private fun releaseSession(sessionId: Int) {
+        releaseEq(sessionId)
+        releaseSurround(sessionId)
+    }
+
+    /** Suelta solo el efecto de SoundAlive; el 3D es un motor aparte. */
+    private fun releaseEq(sessionId: Int) {
+        effects.remove(sessionId)?.let { effect ->
+            clearGlobals(effect)
+            runCatching { effect.release() }
+        }
+    }
+
+    private fun clearGlobals(effect: AudioEffect) {
+        runCatching {
+            effect.setParameter(ints(PARAM_BYPASS), ints(1))
+            effect.enabled = false
+        }
+    }
+
+    private fun apply(effect: AudioEffect) {
+        runCatching {
+            // La curva va entera de una vez: son 9 bandas y con el protocolo de
+            // Samsung hacia falta un setParameter por banda.
+            val levels = effectiveLevels()
+            effect.setParameter(ints(PARAM_CURVE), ints(*IntArray(BANDS) { levels[it] * 100 }))
+            effect.setParameter(ints(PARAM_PREGAIN), ints(pregainFor(levels) * 100))
+            effect.setParameter(ints(PARAM_BYPASS), ints(0))
+            effect.enabled = true
+        }
+    }
+
+    /**
+     * Sin atenuacion: la stock tampoco compensaba la curva, y meter -4 dB se
+     * notaba como volumen bajo. Si hay picos, el limitador del efecto los
+     * absorbe (trabaja en float y satura suave antes de que el HAL recorte).
+     */
+    private fun pregainFor(levels: IntArray): Int = 0
+
+    private fun ints(vararg values: Int): ByteArray {
+        val out = ByteArray(values.size * 4)
+        for (i in values.indices) {
+            out[i * 4] = (values[i] and 0xff).toByte()
+            out[i * 4 + 1] = ((values[i] shr 8) and 0xff).toByte()
+            out[i * 4 + 2] = ((values[i] shr 16) and 0xff).toByte()
+            out[i * 4 + 3] = ((values[i] shr 24) and 0xff).toByte()
+        }
+        return out
+    }
+}
