diff --git a/dap/eq/dapeq.cpp b/dap/eq/dapeq.cpp
new file mode 100755
index 0000000..02a56d8
--- /dev/null
+++ b/dap/eq/dapeq.cpp
@@ -0,0 +1,468 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#define LOG_TAG "DapEq"
+
+#include <complex>
+#include <errno.h>
+#include <math.h>
+#include <new>
+#include <stdlib.h>
+#include <string.h>
+
+#include <hardware/audio_effect.h>
+#include <log/log.h>
+#include <system/audio.h>
+
+namespace {
+
+constexpr int kBands = 9;
+
+// Bandas del motor de la stock: 63/125/250/500/1k/2k/4k/8k/16k Hz.
+constexpr float kBandHz[kBands] = {63.f, 125.f, 250.f, 500.f, 1000.f,
+                                   2000.f, 4000.f, 8000.f, 16000.f};
+
+// La curva del altavoz de la stock, en dB. Es todo lo que haciamos con su motor.
+constexpr float kBaseDb[kBands] = {1.f, 4.f, 3.f, -6.f, 1.f, -3.f, -12.f, -2.f, 4.f};
+
+constexpr float kQ = 1.4f;
+constexpr float kMinDb = -12.f;
+constexpr float kMaxDb = 12.f;
+constexpr float kDefaultPregainDb = -4.f;
+
+// Parametros propios (dB con dos decimales se manda como int32 en centesimas).
+constexpr int32_t kParamBypass = 1;
+constexpr int32_t kParamPregain = 2;
+constexpr int32_t kParamBandFirst = 10;
+constexpr int32_t kParamCurve = 20;
+
+constexpr int kMaxChannels = 2;
+
+// d1e0a001-7c00-4b00-9f00-000000000001
+constexpr effect_uuid_t kUuid = {
+        0xd1e0a001, 0x7c00, 0x4b00, 0x9f00, {0x00, 0x00, 0x00, 0x00, 0x00, 0x01}};
+
+inline float clampf(float v, float lo, float hi) {
+    return v < lo ? lo : (v > hi ? hi : v);
+}
+
+inline float softClip(float x) {
+    constexpr float t = 0.80f;
+    if (x > t) return t + (1.f - t) * tanhf((x - t) / (1.f - t));
+    if (x < -t) return -t - (1.f - t) * tanhf((-x - t) / (1.f - t));
+    return x;
+}
+
+struct DapEqContext {
+    const effect_interface_s *itfe = nullptr;
+    effect_config_t config = {};
+    bool initialized = false;
+    bool configured = false;
+    bool enabled = false;
+    bool bypass = false;
+
+    float pregainDb = kDefaultPregainDb;
+    float gainDb[kBands] = {0};
+
+    // Coeficientes normalizados por a0.
+    float b0[kBands] = {0}, b1[kBands] = {0}, b2[kBands] = {0};
+    float a1[kBands] = {0}, a2[kBands] = {0};
+    float z1[kBands][kMaxChannels] = {};
+    float z2[kBands][kMaxChannels] = {};
+
+    float pregain = 1.f;
+    uint32_t sampleRate = 48000;
+    int channels = kMaxChannels;
+};
+
+int32_t DapEqLib_Create(const effect_uuid_t *uuid, int32_t sessionId, int32_t ioId,
+                        effect_handle_t *pHandle);
+int32_t DapEqLib_Release(effect_handle_t handle);
+int32_t DapEqLib_GetDescriptor(const effect_uuid_t *uuid, effect_descriptor_t *pDescriptor);
+
+int32_t DapEq_Process(effect_handle_t self, audio_buffer_t *inBuffer, audio_buffer_t *outBuffer);
+int32_t DapEq_Command(effect_handle_t self, uint32_t cmdCode, uint32_t cmdSize, void *pCmdData,
+                      uint32_t *replySize, void *pReplyData);
+int32_t DapEq_GetDescriptor(effect_handle_t self, effect_descriptor_t *pDescriptor);
+
+const effect_interface_s gDapEqInterface = {
+        DapEq_Process,
+        DapEq_Command,
+        DapEq_GetDescriptor,
+        nullptr,
+};
+
+}  // namespace
+
+// El simbolo AELI tiene que estar enlazado externamente: dentro de un namespace
+// anonimo queda con linkage interno y EffectsFactory no lo encuentra.
+__attribute__((visibility("default"))) audio_effect_library_t AUDIO_EFFECT_LIBRARY_INFO_SYM = {
+        .tag = AUDIO_EFFECT_LIBRARY_TAG,
+        .version = EFFECT_LIBRARY_API_VERSION,
+        .name = "Speaker EQ Library",
+        .implementor = "The LineageOS Project",
+        .create_effect = DapEqLib_Create,
+        .release_effect = DapEqLib_Release,
+        .get_descriptor = DapEqLib_GetDescriptor,
+};
+
+namespace {
+
+const effect_descriptor_t gDapEqDescriptor = {
+        kUuid,  // type
+        kUuid,  // uuid
+        EFFECT_CONTROL_API_VERSION,
+        // INSERT_FIRST fija la posicion en la cadena: nuestra curva va
+        // siempre antes de Dolby. Con INSERT_LAST el orden dependia de quien
+        // se creara antes y el sonido alternaba entre dos cadenas.
+        EFFECT_FLAG_TYPE_INSERT | EFFECT_FLAG_INSERT_FIRST,
+        0,
+        0,
+        "Speaker EQ",
+        "The LineageOS Project",
+};
+
+void resetState(DapEqContext *ctx) {
+    memset(ctx->z1, 0, sizeof(ctx->z1));
+    memset(ctx->z2, 0, sizeof(ctx->z2));
+}
+
+/**
+ * Coeficientes de las 9 bandas para unos ajustes dados (RBJ peaking).
+ */
+void rawCoefficients(DapEqContext *ctx, const float *gainDb, float fs) {
+    for (int i = 0; i < kBands; i++) {
+        const float gain = clampf(gainDb[i], -15.f, 15.f);
+        // Por encima de Nyquist no se puede filtrar: se deja pasar.
+        if (kBandHz[i] >= fs * 0.45f || gain == 0.f) {
+            ctx->b0[i] = 1.f;
+            ctx->b1[i] = 0.f;
+            ctx->b2[i] = 0.f;
+            ctx->a1[i] = 0.f;
+            ctx->a2[i] = 0.f;
+            continue;
+        }
+        const float A = powf(10.f, gain / 40.f);
+        const float w0 = 2.f * (float)M_PI * kBandHz[i] / fs;
+        const float alpha = sinf(w0) / (2.f * kQ);
+        const float cosw0 = cosf(w0);
+        const float a0 = 1.f + alpha / A;
+
+        ctx->b0[i] = (1.f + alpha * A) / a0;
+        ctx->b1[i] = (-2.f * cosw0) / a0;
+        ctx->b2[i] = (1.f - alpha * A) / a0;
+        ctx->a1[i] = (-2.f * cosw0) / a0;
+        ctx->a2[i] = (1.f - alpha / A) / a0;
+    }
+}
+
+/** Respuesta en dB de una banda a una frecuencia dada. */
+float bandResponseDb(const DapEqContext *ctx, int band, float f) {
+    const float w = 2.f * (float)M_PI * f / (float)ctx->sampleRate;
+    const std::complex<float> z1(cosf(-w), sinf(-w));
+    const std::complex<float> z2 = z1 * z1;
+    const std::complex<float> num = ctx->b0[band] + ctx->b1[band] * z1 + ctx->b2[band] * z2;
+    const std::complex<float> den = 1.f + ctx->a1[band] * z1 + ctx->a2[band] * z2;
+    return 20.f * log10f(std::abs(num) / std::abs(den));
+}
+
+/**
+ * Las bandas estan a una octava y se solapan, asi que la respuesta real es la
+ * SUMA de las 9. Si se pone +4 dB en 125 Hz tal cual, en 125 Hz se miden +4,5 y
+ * en los medios se cuela parte del corte del vecino (a 2 kHz salian -5,5 en vez
+ * de -3): el balance se iba a graves. Aqui se resuelven los puntos de ajuste
+ * para que en el centro de cada banda se mida exactamente lo pedido.
+ */
+void computeCoefficients(DapEqContext *ctx) {
+    const float fs = ctx->sampleRate > 0 ? (float)ctx->sampleRate : 48000.f;
+    float target[kBands];
+    float setpoint[kBands];
+    for (int i = 0; i < kBands; i++) {
+        target[i] = clampf(ctx->gainDb[i], kMinDb, kMaxDb);
+        setpoint[i] = target[i];
+    }
+    for (int it = 0; it < 4; it++) {
+        rawCoefficients(ctx, setpoint, fs);
+        for (int i = 0; i < kBands; i++) {
+            float realized = 0.f;
+            for (int j = 0; j < kBands; j++) {
+                realized += bandResponseDb(ctx, j, kBandHz[i]);
+            }
+            setpoint[i] = clampf(setpoint[i] + target[i] - realized, -15.f, 15.f);
+        }
+    }
+    rawCoefficients(ctx, setpoint, fs);
+
+    ctx->pregain = powf(10.f, clampf(ctx->pregainDb, -24.f, 0.f) / 20.f);
+    ALOGV("coeficientes a %u Hz, pregain %.2f dB", ctx->sampleRate, ctx->pregainDb);
+}
+
+void applyCurveDefaults(DapEqContext *ctx) {
+    for (int i = 0; i < kBands; i++) ctx->gainDb[i] = kBaseDb[i];
+}
+
+int configure(DapEqContext *ctx, const effect_config_t *config) {
+    if (config->inputCfg.samplingRate == 0 || config->inputCfg.channels == 0) {
+        return -EINVAL;
+    }
+    ctx->config = *config;
+    ctx->sampleRate = config->inputCfg.samplingRate;
+
+    const int channels = __builtin_popcount(config->inputCfg.channels);
+    ctx->channels = channels > kMaxChannels ? kMaxChannels : (channels < 1 ? 1 : channels);
+
+    ctx->configured = true;
+    resetState(ctx);
+    computeCoefficients(ctx);
+    return 0;
+}
+
+void passthrough(const audio_buffer_t *in, audio_buffer_t *out, size_t frames,
+                 audio_format_t format, int channels) {
+    size_t bytes = 0;
+    if (format == AUDIO_FORMAT_PCM_FLOAT) {
+        bytes = sizeof(float);
+    } else if (format == AUDIO_FORMAT_PCM_16_BIT) {
+        bytes = sizeof(int16_t);
+    } else {
+        return;
+    }
+    if (in->raw == out->raw) return;
+    memcpy(out->raw, in->raw, frames * (size_t)channels * bytes);
+}
+
+void processFloat(DapEqContext *ctx, const float *src, float *dst, size_t frames, bool accumulate) {
+    const int ch = ctx->channels;
+    for (size_t f = 0; f < frames; f++) {
+        for (int c = 0; c < ch; c++) {
+            const size_t idx = f * ch + c;
+            float x = src[idx] * ctx->pregain;
+            for (int b = 0; b < kBands; b++) {
+                const float y = ctx->b0[b] * x + ctx->z1[b][c];
+                ctx->z1[b][c] = ctx->b1[b] * x - ctx->a1[b] * y + ctx->z2[b][c];
+                ctx->z2[b][c] = ctx->b2[b] * x - ctx->a2[b] * y;
+                x = y;
+            }
+            const float out = softClip(x);
+            dst[idx] = accumulate ? dst[idx] + out : out;
+        }
+    }
+}
+
+int32_t setParameter(DapEqContext *ctx, int32_t param, uint32_t size, void *value) {
+    if (param == kParamBypass) {
+        if (size != sizeof(int32_t)) return -EINVAL;
+        ctx->bypass = *(int32_t *)value != 0;
+        resetState(ctx);
+        return 0;
+    }
+    if (param == kParamPregain) {
+        if (size != sizeof(int32_t)) return -EINVAL;
+        ctx->pregainDb = *(int32_t *)value / 100.f;
+        computeCoefficients(ctx);
+        return 0;
+    }
+    if (param >= kParamBandFirst && param < kParamBandFirst + kBands) {
+        if (size != sizeof(int32_t)) return -EINVAL;
+        ctx->gainDb[param - kParamBandFirst] = *(int32_t *)value / 100.f;
+        computeCoefficients(ctx);
+        return 0;
+    }
+    if (param == kParamCurve) {
+        if (size != kBands * sizeof(int32_t)) return -EINVAL;
+        const int32_t *curve = (const int32_t *)value;
+        for (int i = 0; i < kBands; i++) ctx->gainDb[i] = curve[i] / 100.f;
+        computeCoefficients(ctx);
+        return 0;
+    }
+    ALOGE("setParameter: parametro %d desconocido", param);
+    return -EINVAL;
+}
+
+int32_t getParameter(DapEqContext *ctx, int32_t param, uint32_t *size, void *value) {
+    if (param == kParamBypass) {
+        if (*size < sizeof(int32_t)) return -EINVAL;
+        *(int32_t *)value = ctx->bypass ? 1 : 0;
+        *size = sizeof(int32_t);
+        return 0;
+    }
+    if (param == kParamPregain) {
+        if (*size < sizeof(int32_t)) return -EINVAL;
+        *(int32_t *)value = (int32_t)(ctx->pregainDb * 100.f);
+        *size = sizeof(int32_t);
+        return 0;
+    }
+    if (param >= kParamBandFirst && param < kParamBandFirst + kBands) {
+        if (*size < sizeof(int32_t)) return -EINVAL;
+        *(int32_t *)value = (int32_t)(ctx->gainDb[param - kParamBandFirst] * 100.f);
+        *size = sizeof(int32_t);
+        return 0;
+    }
+    if (param == kParamCurve) {
+        if (*size < kBands * sizeof(int32_t)) return -EINVAL;
+        int32_t *curve = (int32_t *)value;
+        for (int i = 0; i < kBands; i++) curve[i] = (int32_t)(ctx->gainDb[i] * 100.f);
+        *size = kBands * sizeof(int32_t);
+        return 0;
+    }
+    return -EINVAL;
+}
+
+int32_t DapEqLib_Create(const effect_uuid_t *uuid, int32_t sessionId, int32_t ioId,
+                        effect_handle_t *pHandle) {
+    if (pHandle == nullptr) return -EINVAL;
+    if (uuid != nullptr && memcmp(uuid, &kUuid, sizeof(effect_uuid_t)) != 0) return -ENOENT;
+
+    DapEqContext *ctx = new (std::nothrow) DapEqContext();
+    if (ctx == nullptr) return -ENOMEM;
+
+    ctx->itfe = &gDapEqInterface;
+    // La curva del altavoz va siempre puesta: no depende de que la app la pida.
+    applyCurveDefaults(ctx);
+    computeCoefficients(ctx);
+
+    *pHandle = (effect_handle_t)ctx;
+    ALOGI("creado (session %d, io %d)", sessionId, ioId);
+    return 0;
+}
+
+int32_t DapEqLib_Release(effect_handle_t handle) {
+    if (handle == nullptr) return -EINVAL;
+    delete (DapEqContext *)handle;
+    return 0;
+}
+
+int32_t DapEqLib_GetDescriptor(const effect_uuid_t *uuid, effect_descriptor_t *pDescriptor) {
+    if (pDescriptor == nullptr) return -EINVAL;
+    if (uuid != nullptr && memcmp(uuid, &kUuid, sizeof(effect_uuid_t)) != 0) return -ENOENT;
+    *pDescriptor = gDapEqDescriptor;
+    return 0;
+}
+
+int32_t DapEq_GetDescriptor(effect_handle_t self, effect_descriptor_t *pDescriptor) {
+    if (self == nullptr || pDescriptor == nullptr) return -EINVAL;
+    *pDescriptor = gDapEqDescriptor;
+    return 0;
+}
+
+int32_t DapEq_Process(effect_handle_t self, audio_buffer_t *inBuffer, audio_buffer_t *outBuffer) {
+    DapEqContext *ctx = (DapEqContext *)self;
+    if (ctx == nullptr || !ctx->initialized) return -EINVAL;
+    if (inBuffer == nullptr || inBuffer->raw == nullptr || outBuffer == nullptr ||
+        outBuffer->raw == nullptr) {
+        return -EINVAL;
+    }
+    const size_t frames = inBuffer->frameCount;
+    if (frames == 0) return 0;
+
+    const audio_format_t format = (audio_format_t)ctx->config.inputCfg.format;
+    const int channels = __builtin_popcount(ctx->config.inputCfg.channels);
+    const bool processable = ctx->enabled && !ctx->bypass && ctx->configured &&
+            format == AUDIO_FORMAT_PCM_FLOAT && channels <= kMaxChannels;
+
+    // Todo lo que no se procesa se copia tal cual: devolver -EINVAL haria que
+    // AudioFlinger considerase el efecto roto y lo soltase de la cadena.
+    if (!processable) {
+        passthrough(inBuffer, outBuffer, frames, format, channels);
+        return 0;
+    }
+
+    const bool accumulate = ctx->config.outputCfg.accessMode == EFFECT_BUFFER_ACCESS_ACCUMULATE;
+    processFloat(ctx, inBuffer->f32, outBuffer->f32, frames, accumulate);
+    return 0;
+}
+
+int32_t DapEq_Command(effect_handle_t self, uint32_t cmdCode, uint32_t cmdSize, void *pCmdData,
+                      uint32_t *replySize, void *pReplyData) {
+    DapEqContext *ctx = (DapEqContext *)self;
+    if (ctx == nullptr) return -EINVAL;
+
+    switch (cmdCode) {
+        case EFFECT_CMD_INIT:
+            if (pReplyData == nullptr || replySize == nullptr || *replySize != sizeof(int32_t)) {
+                return -EINVAL;
+            }
+            ctx->initialized = true;
+            *(int32_t *)pReplyData = 0;
+            return 0;
+
+        case EFFECT_CMD_SET_CONFIG:
+            if (pCmdData == nullptr || cmdSize != sizeof(effect_config_t) ||
+                pReplyData == nullptr || replySize == nullptr ||
+                *replySize != sizeof(int32_t)) {
+                return -EINVAL;
+            }
+            *(int32_t *)pReplyData = configure(ctx, (const effect_config_t *)pCmdData);
+            return 0;
+
+        case EFFECT_CMD_GET_CONFIG:
+            if (pReplyData == nullptr || replySize == nullptr ||
+                *replySize != sizeof(effect_config_t)) {
+                return -EINVAL;
+            }
+            *(effect_config_t *)pReplyData = ctx->config;
+            return 0;
+
+        case EFFECT_CMD_RESET:
+            resetState(ctx);
+            return 0;
+
+        case EFFECT_CMD_ENABLE:
+            if (pReplyData == nullptr || replySize == nullptr || *replySize != sizeof(int32_t)) {
+                return -EINVAL;
+            }
+            resetState(ctx);
+            ctx->enabled = true;
+            *(int32_t *)pReplyData = 0;
+            return 0;
+
+        case EFFECT_CMD_DISABLE:
+            if (pReplyData == nullptr || replySize == nullptr || *replySize != sizeof(int32_t)) {
+                return -EINVAL;
+            }
+            ctx->enabled = false;
+            resetState(ctx);
+            *(int32_t *)pReplyData = 0;
+            return 0;
+
+        case EFFECT_CMD_SET_PARAM: {
+            if (pCmdData == nullptr || cmdSize < sizeof(effect_param_t) + sizeof(int32_t) ||
+                pReplyData == nullptr || replySize == nullptr ||
+                *replySize != sizeof(int32_t)) {
+                return -EINVAL;
+            }
+            effect_param_t *cmd = (effect_param_t *)pCmdData;
+            if (cmd->psize != sizeof(int32_t)) return -EINVAL;
+            *(int32_t *)pReplyData =
+                    setParameter(ctx, *(int32_t *)cmd->data, cmd->vsize, cmd->data + sizeof(int32_t));
+            return 0;
+        }
+
+        case EFFECT_CMD_GET_PARAM: {
+            if (pCmdData == nullptr || cmdSize < sizeof(effect_param_t) + sizeof(int32_t) ||
+                pReplyData == nullptr || replySize == nullptr ||
+                *replySize < sizeof(effect_param_t) + 2 * sizeof(int32_t)) {
+                return -EINVAL;
+            }
+            effect_param_t *rep = (effect_param_t *)pReplyData;
+            memcpy(pReplyData, pCmdData, sizeof(effect_param_t) + sizeof(int32_t));
+            rep->status = getParameter(ctx, *(int32_t *)rep->data, &rep->vsize,
+                                       rep->data + sizeof(int32_t));
+            *replySize = sizeof(effect_param_t) + sizeof(int32_t) + rep->vsize;
+            return 0;
+        }
+
+        case EFFECT_CMD_SET_DEVICE:
+        case EFFECT_CMD_SET_VOLUME:
+        case EFFECT_CMD_SET_AUDIO_MODE:
+            return 0;
+
+        default:
+            ALOGV("comando %u no soportado", cmdCode);
+            return -EINVAL;
+    }
+}
+
+}  // namespace
\ No newline at end of file
