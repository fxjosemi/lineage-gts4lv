+package org.lineageos.dap
+
+import android.content.Context
+import android.util.AttributeSet
+
+import androidx.preference.Preference
+import androidx.preference.PreferenceViewHolder
+
+/** Preferencia que hospeda el ecualizador de 9 bandas de [EqualizerView]. */
+class EqualizerPreference(context: Context, attrs: AttributeSet?) :
+        Preference(context, attrs) {
+
+    var onValuesChanged: ((IntArray) -> Unit)? = null
+
+    private var view: EqualizerView? = null
+    private var values = IntArray(SoundAliveCore.BANDS)
+    private var editable = true
+
+    init {
+        layoutResource = R.layout.preference_equalizer
+        isSelectable = false
+    }
+
+    fun setValues(levels: IntArray) {
+        values = IntArray(SoundAliveCore.BANDS) { levels.getOrElse(it) { 0 } }
+        view?.setLevels(values)
+    }
+
+    fun getValues(): IntArray = view?.getLevels() ?: values.copyOf()
+
+    fun setEditable(value: Boolean) {
+        editable = value
+        view?.setEditable(value)
+    }
+
+    override fun onBindViewHolder(holder: PreferenceViewHolder) {
+        super.onBindViewHolder(holder)
+        val equalizer = holder.itemView.findViewById<EqualizerView>(R.id.eq_view) ?: return
+        view = equalizer
+        equalizer.setLevels(values)
+        equalizer.setEditable(editable)
+        equalizer.onLevelsChanged = { levels ->
+            values = levels
+            onValuesChanged?.invoke(levels)
+        }
+    }
+}
