+// Efecto de ecualizacion del altavoz, sin dependencias de Samsung.
+// El HAL de efectos es de 32 bits, asi que se instala en las dos variantes.
+cc_library_shared {
+    name: "libdapeq",
+    stem: "libdapeq",
+    vendor: true,
+    relative_install_path: "soundfx",
+    compile_multilib: "both",
+    srcs: [
+        "dapeq.cpp",
+    ],
+    header_libs: [
+        "libhardware_headers",
+        "libaudio_system_headers",
+    ],
+    shared_libs: [
+        "liblog",
+    ],
+    cflags: [
+        "-Wall",
+        "-Werror",
+        "-Wno-unused-parameter",
+        "-fvisibility=hidden",
+    ],
+}
